# Local desktop defaults
APP_HOST=127.0.0.1
APP_PORT=7860
API_HOST=127.0.0.1
API_PORT=8000
OLLAMA_HOST=http://127.0.0.1:11434
# 4b fits 6GB VRAM 100% GPU; switch to english-tutor-local:8b on 8GB+ GPUs.
OLLAMA_MODEL=english-tutor-local:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Set a long random value before exposing FastAPI to LAN/company network.
TUTOR_API_TOKEN=

# Upload safety limits
MAX_ATTACHMENT_FILES=5
MAX_DOCUMENT_MB=20
MAX_IMAGE_MB=10
MAX_IMAGE_MEGAPIXELS=25
MAX_VIDEO_MB=150
MAX_ATTACHMENT_TOTAL_MB=180
MAX_PDF_PAGES=250

# Offline mascot speech (no third-party inference API)
TTS_ENABLED=true
TTS_VI_MODEL=vi_VN-vais1000-medium
TTS_EN_MODEL=en_US-lessac-medium
TTS_MAX_CHARACTERS=800
TTS_MAX_CACHE_FILES=100

# Optional full MinerU OCR. Use scripts/setup_mineru.ps1 on a drive with 25GB+ free.
MINERU_EXECUTABLE=
MINERU_BACKEND=pipeline
MINERU_TIMEOUT_SECONDS=900

# Optional Google visual matching. This is separate from OAuth login.
# Tris AI sends an image only after the user checks the consent box.
GOOGLE_VISION_API_KEY=
VISUAL_SEARCH_TIMEOUT_SECONDS=20
VISUAL_SEARCH_MAX_RESULTS=8

# Local image understanding (Google Lens style) on a multimodal Ollama model.
VISION_MODEL=qwen2.5vl:3b
VISION_TIMEOUT_SECONDS=240

# Keyless web search (DuckDuckGo) with local page reading for grounded answers.
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=20
WEB_SEARCH_MAX_PAGES=3
WEB_FETCH_MAX_CHARACTERS=6000

# Local media generation (image/GIF/video) in runtime/imagegen, sd-turbo by
# default because 4-step rendering fits a 6GB GPU. Install with
# scripts/setup_imagegen.ps1. OLLAMA_KEEP_ALIVE keeps chat models resident
# between messages so follow-up turns skip the reload cost.
IMAGEGEN_MODEL=stabilityai/sd-turbo
IMAGEGEN_TIMEOUT_SECONDS=900
OLLAMA_KEEP_ALIVE=30m
OLLAMA_LOAD_TIMEOUT_SECONDS=240
OLLAMA_CHAT_MAX_TOKENS=640

# Auto-shutdown: when the last browser tab closes, exit the whole app after
# this many seconds (also frees Ollama VRAM). Set higher if you want a longer
# window to reopen the page without relaunching.
TUTOR_SHUTDOWN_GRACE_SECONDS=120

# Optional: connect to a Qdrant server instead of embedded local storage.
QDRANT_URL=

# PostgreSQL is required for account/password features.
TUTOR_POSTGRES_DSN=postgresql://english_tutor:change-me@127.0.0.1:5432/english_tutor_accounts
TUTOR_AUTH_REQUIRED=true
TUTOR_AUTH_SESSION_HOURS=24

# Social sign-in. Create these values in Google Cloud / Meta for Developers.
# Never commit real secrets. Local callback URIs must match exactly:
# http://127.0.0.1:8000/v1/auth/oauth/google/callback
# http://127.0.0.1:8000/v1/auth/oauth/facebook/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0
OAUTH_PUBLIC_BASE_URL=http://127.0.0.1:8000
WEB_PUBLIC_BASE_URL=http://127.0.0.1:7860
TUTOR_OAUTH_SESSION_SECRET=
